{
  "info": {
    "name": "WanderVibe",
    "description": "Live /api/plans and /api/invites flow. Run the collection in order against a server that is already listening.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let stamp = pm.variables.get('stamp');",
          "if (!stamp) {",
          "  stamp = Date.now().toString();",
          "  pm.variables.set('stamp', stamp);",
          "  pm.environment.set('emailA', 'usera.' + stamp + '@example.com');",
          "  pm.environment.set('emailB', 'userb.' + stamp + '@example.com');",
          "  pm.environment.set('emailC', 'userc.' + stamp + '@example.com');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 Health",
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "noauth" },
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health is running', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.text()).to.include('WanderVibe Backend is running');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Register A",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "auth": { "type": "noauth" },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('register A returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "  pm.environment.set('tokenA', body.token);",
              "  pm.environment.set('userAId', userIdFromAuth(body));",
              "});",
              "function userIdFromAuth(body) {",
              "  const user = body.user || {};",
              "  let id = user._id || user.id || '';",
              "  if (!id && body.token) {",
              "    let segment = String(body.token).split('.')[1] || '';",
              "    segment = segment.replace(/-/g, '+').replace(/_/g, '/');",
              "    while (segment.length % 4) segment += '=';",
              "    const payload = JSON.parse(require('atob')(segment));",
              "    id = payload.userId || payload.id || '';",
              "  }",
              "  if (!id) throw new Error('auth response has no user id');",
              "  return id;",
              "}"
            ]
          }
        }
      ]
    },
